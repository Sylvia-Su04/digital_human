*.wav
*.mp3
*.flac
*.ogg
*.mp4
*.avi
*.mov
*.mkv
*.gif
ref/*
!ref/.gitkeep

# ==================== 输出文件 ====================
outputs/*
!outputs/.gitkeep
result.mp4
temp_voice.wav
temp_*.wav

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/

# ==================== 虚拟环境 ====================
venv/
env/
.venv/
.env/

# ==================== IDE / 编辑器 ====================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

